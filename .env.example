PORT=5000

# Create an API key at https://resend.com/api-keys.
# Keep this value on the backend only; never add it to frontend variables.
RESEND_API_KEY=re_your_api_key_here

# RESEND_FROM must use a Resend-verified sending domain.
RESEND_FROM="Portfolio Contact <contact@yourdomain.com>"
MAIL_TO=your-email@gmail.com
